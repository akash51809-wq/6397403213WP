# Server
PORT=10000
NODE_ENV=production

# PostgreSQL Database (Render or Local)
# On Render: copy the "Internal Database URL" (if service is also on Render) or "External Database URL"
DATABASE_URL=postgresql://whatsapp_user:YOUR_PASSWORD@YOUR_RENDER_DB_HOST/whatsapp_bot_db

# WhatsApp Session Encryption (AES-256)
# Minimum 16 characters string for encrypting WhatsApp credentials at rest
SESSION_ENCRYPTION_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_KEY_AT_LEAST_16_CHARS

# Authentication
# Generate a long random value. Used for signing login/session tokens.
AUTH_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# Master API token
API_MASTER_TOKEN=YOUR_API_MASTER_TOKEN

# User password settings
USER_PASSWORD_LENGTH=10

# OTP settings
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5

# Admin WhatsApp session
ADMIN_WHATSAPP_SESSION_ID=admin

# Public application URL
APP_URL=https://your-service-name.onrender.com
AUTOPING_URL=https://your-service-name.onrender.com/ping
