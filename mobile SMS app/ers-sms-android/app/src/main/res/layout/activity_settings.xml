<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="गेटवे सेटिंग्स"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="डुअल सिम रूटिंग, सेंडर आईडी फ़िल्टर एवं सर्वर कनेक्शन"
            android:textSize="13sp"
            android:textColor="@color/text_secondary" />

        <!-- OPTION 1: Allow SIM for Send Outgoing Msg -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:background="@drawable/bg_3d_card"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_outgoing_sim"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/desc_outgoing_sim"
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />

            <RadioGroup
                android:id="@+id/rgOutgoingSim"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <RadioButton
                    android:id="@+id/rbOutBoth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sim_opt_both"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/rbOutSim1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sim_opt_1"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/rbOutSim2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sim_opt_2"
                    android:textColor="@color/text_primary" />
            </RadioGroup>
        </LinearLayout>

        <!-- OPTION 2: Allow Forward Incoming Msg -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:background="@drawable/bg_3d_card"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_incoming_sim"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/desc_incoming_sim"
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />

            <RadioGroup
                android:id="@+id/rgIncomingSim"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <RadioButton
                    android:id="@+id/rbInBoth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sim_opt_both"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/rbInSim1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sim_opt_1"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/rbInSim2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sim_opt_2"
                    android:textColor="@color/text_primary" />
            </RadioGroup>
        </LinearLayout>

        <!-- OPTION 3: Choose SMS Sender ID Filter -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:background="@drawable/bg_3d_card"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_sender_id_filter"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/desc_sender_id_filter"
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />

            <RadioGroup
                android:id="@+id/rgSenderFilter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <RadioButton
                    android:id="@+id/rbSenderAll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sender_filter_all"
                    android:textColor="@color/text_primary" />

                <RadioButton
                    android:id="@+id/rbSenderCustom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sender_filter_custom"
                    android:textColor="@color/text_primary" />
            </RadioGroup>

            <!-- Sender ID Whitelist TextInput (Shown when Custom is selected) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilSenderWhitelist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="सेंडर आईडी टाइप करें"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSenderWhitelist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_sender_id"
                    android:textColor="@color/text_primary"
                    android:inputType="textCapCharacters" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tvSenderIdNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/note_sender_id"
                android:textSize="11sp"
                android:textColor="@color/text_muted" />

        </LinearLayout>

        <!-- SERVER CREDENTIALS CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:background="@drawable/bg_3d_card"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="सर्वर एवं डिवाइस कॉन्फ़िगरेशन"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <!-- Server URL -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilServerUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/label_server_url"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etServerUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- API Key -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilApiKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/label_api_key"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etApiKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Device Name -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDeviceName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/label_device_name"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDeviceName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <!-- 24x7 Battery & System Persistence -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:background="@drawable/bg_3d_card"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="24x7 लॉक स्क्रीन एक्टिवेशन"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="फोन की स्क्रीन लॉक होने पर भी ऐप बैकग्राउंड में लगातार कनेक्टेड रहे इसके लिए बैटरी ऑप्टिमाइज़ेशन हटाएं।"
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBatteryOptimization"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:text="⚡ बैटरी ऑप्टिमाइज़ेशन हटाएं (24x7 रन)"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="@color/accent"
                android:textColor="@color/accent"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCheckUpdateSettings"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="🚀 नया ऐप अपडेट चेक करें"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="@color/primary_light"
                android:textColor="@color/primary_light"
                app:cornerRadius="10dp" />

        </LinearLayout>

        <!-- Save Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:text="@string/btn_save"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:elevation="6dp"
            android:backgroundTint="@color/primary" />

    </LinearLayout>
</ScrollView>
