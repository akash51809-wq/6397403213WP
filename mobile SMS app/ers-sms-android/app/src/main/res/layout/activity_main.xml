<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 3D Futuristic Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="12dp">

            <!-- App Logo Badge -->
            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="ERS Logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_tagline"
                    android:textSize="12sp"
                    android:textColor="@color/primary_light" />
            </LinearLayout>

            <!-- Check for Update Quick Button -->
            <ImageButton
                android:id="@+id/btnCheckUpdate"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/stat_sys_download_done"
                app:tint="@color/primary_light"
                android:contentDescription="Check for Update" />

            <!-- Settings Button -->
            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_manage"
                app:tint="@color/text_primary"
                android:contentDescription="Settings" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingBottom="24dp">

                <!-- 1. 3D Connection Status Neon Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_3d_card_neon"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- Glowing Neon Dot -->
                        <View
                            android:id="@+id/viewStatusDot"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:background="@drawable/status_dot_offline" />

                        <TextView
                            android:id="@+id/tvStatusText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:text="@string/status_disconnected"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/status_offline" />

                        <!-- 24x7 Service Switch -->
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchService"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <!-- Lock Screen Always-Connected Badge -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp"
                        android:background="#1510B981"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔒 24x7 ऑलवेज कनेक्टेड (स्क्रीन लॉक कंडीशन में भी एक्टिव)"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/accent" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="@color/card_border" />

                    <!-- Server Details -->
                    <TextView
                        android:id="@+id/tvServerDetails"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="सर्वर: कॉन्फ़िगर नहीं है"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tvDeviceDetails"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="डिवाइस: Android Phone"
                        android:textSize="12sp"
                        android:textColor="@color/text_muted" />

                </LinearLayout>

                <!-- 2. 3D Dual-SIM Chips Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical"
                    android:background="@drawable/bg_3d_card"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <View
                            android:layout_width="22dp"
                            android:layout_height="16dp"
                            android:background="@drawable/bg_sim_chip" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:text="डुअल सिम स्थिति (Dual-SIM Hardware)"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:id="@+id/tvSimRoutingBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SIM 1 + SIM 2"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/chip_gold"
                            android:background="#20F59E0B"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="2dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvSimInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="सिम कार्ड की जानकारी लोड हो रही है..."
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp"
                        android:textColor="@color/text_secondary" />

                </LinearLayout>

                <!-- 3. 3D Quick Action Buttons Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="14dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnScanQr"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="@string/btn_scan_qr"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:cornerRadius="12dp"
                        app:elevation="4dp"
                        android:backgroundTint="@color/primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTestSms"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="@string/btn_test_sms"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:cornerRadius="12dp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        app:strokeColor="@color/primary_light"
                        android:textColor="@color/primary_light" />
                </LinearLayout>

                <!-- 4. Live Activity Logs Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/recent_logs_title"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/tvClearLogs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="लॉग्स हटाएं"
                        android:textSize="13sp"
                        android:textColor="@color/primary_light"
                        android:background="?attr/selectableItemBackground"
                        android:padding="4dp" />
                </LinearLayout>

                <!-- Empty logs placeholder -->
                <TextView
                    android:id="@+id/tvEmptyLogs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/no_logs"
                    android:textSize="13sp"
                    android:textColor="@color/text_muted"
                    android:gravity="center"
                    android:padding="28dp" />

                <!-- Logs RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvLogs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_sms_log" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
