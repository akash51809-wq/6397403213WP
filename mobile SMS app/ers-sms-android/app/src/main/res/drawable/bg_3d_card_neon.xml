<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom Shadow Layer -->
    <item
        android:left="0dp"
        android:top="4dp"
        android:right="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/card_shadow" />
        </shape>
    </item>

    <!-- Outer Glow Accent -->
    <item
        android:left="0dp"
        android:top="0dp"
        android:right="0dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="270"
                android:startColor="#2038BDF8"
                android:endColor="#1010B981"
                android:type="linear" />
            <stroke
                android:width="1.5dp"
                android:color="@color/card_border_glow" />
        </shape>
    </item>

    <!-- Inner Elevated Surface -->
    <item
        android:left="1.5dp"
        android:top="1.5dp"
        android:right="1.5dp"
        android:bottom="5.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="270"
                android:startColor="@color/surface_card_top"
                android:endColor="@color/surface_card_bottom"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
