<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom Shadow Layer -->
    <item
        android:left="0dp"
        android:top="3dp"
        android:right="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#023047" />
        </shape>
    </item>

    <!-- Main Button Gradient Surface -->
    <item
        android:left="0dp"
        android:top="0dp"
        android:right="0dp"
        android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:angle="270"
                android:startColor="#0284C7"
                android:endColor="#0369A1"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#38BDF8" />
        </shape>
    </item>
</layer-list>
