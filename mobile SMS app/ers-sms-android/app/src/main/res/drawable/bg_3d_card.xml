<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom Shadow Layer for 3D depth -->
    <item
        android:left="0dp"
        android:top="3dp"
        android:right="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/card_shadow" />
        </shape>
    </item>

    <!-- Main Card Body Layer with Top-down 3D bevel gradient -->
    <item
        android:left="0dp"
        android:top="0dp"
        android:right="0dp"
        android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="270"
                android:startColor="@color/surface_card_top"
                android:endColor="@color/surface_card_bottom"
                android:type="linear" />
            <stroke
                android:width="1.5dp"
                android:color="@color/card_border" />
        </shape>
    </item>
</layer-list>
